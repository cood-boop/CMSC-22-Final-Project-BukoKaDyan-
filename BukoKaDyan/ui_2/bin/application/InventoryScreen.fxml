<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.2376" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.NavController">
  <items>

    <!-- ================= SIDEBAR ================= -->
    <AnchorPane minWidth="120.0" prefWidth="142.0" styleClass="sidebar" SplitPane.resizableWithParent="false">
      <children>
        <!-- logo: stretches across the sidebar and keeps the image centered -->
        <HBox alignment="CENTER" layoutY="9.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="9.0">
          <children>
            <ImageView fitHeight="69.0" fitWidth="163.0" pickOnBounds="true" preserveRatio="true">
              <image>
                <Image url="@../Icons/logo.png" />
              </image>
            </ImageView>
          </children>
        </HBox>

        <VBox layoutX="8.0" layoutY="102.0" spacing="1.0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="8.0" AnchorPane.topAnchor="95.0">
          <children>
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goDashboard" prefHeight="32.0" styleClass="buttonDashboard" text="Dashboard">
              <graphic>
                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true" styleClass="icon-dashboard">
                  <image>
                    <Image url="@../Icons/dashboard.png" />
                  </image>
                </ImageView>
              </graphic>
            </Button>
            <!-- current page = Products/Inventory, so it has the "active" class -->
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goProducts" prefHeight="32.0" styleClass="buttonDashboard, active" text="Products">
              <graphic>
                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true" styleClass="icon-products">
                  <image>
                    <Image url="@../Icons/products.png" />
                  </image>
                </ImageView>
              </graphic>
            </Button>
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goOrders" prefHeight="32.0" styleClass="buttonDashboard" text="Orders">
              <graphic>
                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true" styleClass="icon-orders">
                  <image>
                    <Image url="@../Icons/order.png" />
                  </image>
                </ImageView>
              </graphic>
            </Button>
          </children>
        </VBox>

        <Button id="signout_btn" maxWidth="Infinity" mnemonicParsing="false" onAction="#signOut" prefHeight="32.0" styleClass="buttonDashboard" text="Sign out" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="8.0">
          <graphic>
            <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
              <image>
                <Image url="@../Icons/signout.png" />
              </image>
            </ImageView>
          </graphic>
        </Button>
      </children>
    </AnchorPane>

    <!-- ================= MAIN CONTENT ================= -->
    <AnchorPane minWidth="0.0">
      <children>
        <ToolBar id="toolbar" prefHeight="38.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="7.0">
          <items>
            <Button mnemonicParsing="false" onAction="#goInventory" styleClass="toolbarButton, active" text="Inventory" />
            <Button mnemonicParsing="false" onAction="#goAllProducts" styleClass="toolbarButton" text="All Products" />
            <!-- spacer: pushes the icons to the right edge -->
            <Region HBox.hgrow="ALWAYS" />
            <Button contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" styleClass="toolbarIcon">
              <graphic>
                <ImageView fitHeight="22.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                    <Image url="@../Icons/profile.png" />
                  </image>
                </ImageView>
              </graphic>
            </Button>
            <Button contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" styleClass="toolbarIcon">
              <graphic>
                <ImageView fitHeight="22.0" fitWidth="21.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                    <Image url="@../Icons/notification.png" />
                  </image>
                </ImageView>
              </graphic>
            </Button>
          </items>
        </ToolBar>

        <!-- stays on the right edge when the window is resized -->
        <Button mnemonicParsing="false" prefHeight="24.0" prefWidth="70.0" styleClass="primaryButton" text="Save           &gt;" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="77.0" />

        <!-- stretches in all directions with the window -->
        <TableView styleClass="dataTable" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="109.0">
          <columns>
            <TableColumn prefWidth="70.0" text="Visual" />
            <TableColumn prefWidth="215.0" text="Name" />
            <TableColumn prefWidth="52.0" text="Stock" />
            <TableColumn prefWidth="49.0" text="Price" />
            <TableColumn prefWidth="30.0" />
          </columns>
          <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
          </columnResizePolicy>
        </TableView>
      </children>
    </AnchorPane>

  </items>
</SplitPane>
