<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="215.0" spacing="6.0" styleClass="product-card" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1">
   
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   
   <children>
      <!-- Centered Product Image -->
      <HBox alignment="CENTER">
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
         <children>
            <ImageView fx:id="productImage" fitHeight="120.0" fitWidth="178.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </HBox>
      <Label id="card-title" fx:id="priceLabel" styleClass="card-detail" />

            <!-- Product Details -->
      <Label id="card-price" fx:id="priceLabel" styleClass="card-detail" text="Price: " />
      <Label id="card-stock" fx:id="stockLabel" styleClass="card-detail" text="Stock:" />
      <Label id="card-descrip" fx:id="descLabel" styleClass="card-detail" text="Description: " wrapText="true" />

      <!-- Bottom-Right Edit Icon Button -->
      <HBox alignment="CENTER_RIGHT">
         <VBox.margin>
            <Insets top="4.0" />
         </VBox.margin>
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="editBtn" mnemonicParsing="false" styleClass="edit-icon-btn" text="✎" />
         </children>
      </HBox>
   </children>
</VBox>
